---
import { affiliateList } from '../../data/affiliates';

export function getStaticPaths() {
  return affiliateList.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>正在前往 {item.name} 专属通道...</title>
    <!-- 禁止搜索引擎索引转跳中转页 -->
    <meta name="robots" content="noindex, nofollow" />
    <!-- 0秒极速 HTTP Meta 刷新跳转 -->
    <meta http-equiv="refresh" content={`0; url=${item.targetUrl}`} />
    <!-- 客户端无缝 JavaScript 跳转 -->
    <script define:vars={{ targetUrl: item.targetUrl }}>
      window.location.replace(targetUrl);
    </script>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", sans-serif;
        background-color: #F5EFE6;
        color: #2D261E;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        padding: 20px;
        box-sizing: border-box;
      }
      .card {
        background: #FAF7F2;
        border: 1px solid #E4D8C7;
        border-radius: 24px;
        padding: 40px 32px;
        text-align: center;
        max-width: 440px;
        width: 100%;
        box-shadow: 0 10px 30px rgba(74, 62, 49, 0.08);
      }
      .icon {
        font-size: 52px;
        margin-bottom: 16px;
        display: inline-block;
      }
      h1 {
        font-size: 20px;
        font-weight: 800;
        margin: 0 0 10px 0;
        color: #1F1913;
      }
      p {
        font-size: 13px;
        color: #6C5A48;
        line-height: 1.6;
        margin: 0 0 24px 0;
      }
      .btn {
        display: inline-block;
        background: #2D261E;
        color: #FAF7F2;
        font-size: 13px;
        font-weight: 700;
        padding: 12px 24px;
        border-radius: 14px;
        text-decoration: none;
        transition: background 0.2s, transform 0.1s;
      }
      .btn:hover {
        background: #9d6828;
      }
      .btn:active {
        transform: scale(0.98);
      }
      .spinner {
        width: 24px;
        height: 24px;
        border: 3px solid #E8DEC8;
        border-top-color: #9d6828;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 16px auto;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="spinner"></div>
      <div class="icon">{item.icon}</div>
      <h1>正在前往 {item.name}</h1>
      <p>正在为您安全转接至官方合作伙伴页面，尊享 HDC 空间专属特惠 / 最优折扣通道...</p>
      <a href={item.targetUrl} rel="nofollow sponsored" class="btn">
        未自动跳转？点击立即进入 →
      </a>
    </div>
  </body>
</html>
