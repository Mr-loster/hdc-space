---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import { affiliateList } from '../data/affiliates';

const categoryTabs = [
  { key: 'all', nameZh: '全部好物', nameEn: 'All Gear' },
  { key: 'Web3', nameZh: '数字金融/Web3', nameEn: 'Crypto & Finance' },
  { key: '软件', nameZh: '生产力软件', nameEn: 'Productivity Apps' },
  { key: '数码', nameZh: '硬件数码', nameEn: 'Desk Setup' },
  { key: 'AI', nameZh: '开发与AI', nameEn: 'AI & Dev Tools' },
  { key: '生活', nameZh: '生活好物', nameEn: 'Everyday Gear' },
];
---

<BaseLayout
  title="精选好物与工具推荐"
  description="经过 HDC 长期实测、高频使用的数字生产力工具与硬核数码外设精选清单。"
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <!-- Header -->
    <div class="max-w-2xl mb-8">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400 mb-2">
        <span>⚡</span>
        <span class="lang-zh">精选好物与主力装备</span>
        <span class="lang-en">Curated Gear & Tools</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-kraft-950 dark:text-stone-50 tracking-tight mb-4">
        <span class="lang-zh">HDC 的生产力装备清单</span>
        <span class="lang-en">The Essential Gear Guide</span>
      </h1>
      <p class="text-sm text-kraft-700 dark:text-stone-300 leading-relaxed">
        <span class="lang-zh">
          这里仅收录 HDC 真实拥有、深度使用并严选推荐的效率工具、SaaS 与数码硬件。所有外链均已接入官方合作伙伴渠道。
        </span>
        <span class="lang-en">
          Only items personally owned and battle-tested by HDC are featured here. Outbound links connect directly to verified partner stores.
        </span>
      </p>
    </div>

    <AffiliateDisclosure />

    {affiliateList.length > 0 ? (
      <>
        <!-- Filter Buttons -->
        <div class="flex flex-wrap items-center gap-2 my-8" id="category-filter-container">
          {categoryTabs.map((tab, idx) => (
            <button
              type="button"
              data-filter={tab.key}
              class={`cat-btn px-4 py-2 rounded-xl text-xs font-bold transition-all ${
                idx === 0
                  ? 'bg-kraft-900 text-kraft-50 dark:bg-stone-100 dark:text-stone-950 shadow-xs'
                  : 'bg-[#FAF7F2] text-kraft-700 hover:bg-kraft-150 dark:bg-stone-900 dark:text-stone-300 dark:hover:bg-stone-800 border border-kraft-250 dark:border-stone-800'
              }`}
            >
              <span class="lang-zh">{tab.nameZh}</span>
              <span class="lang-en">{tab.nameEn}</span>
            </button>
          ))}
        </div>

        <!-- Product Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="products-grid">
          {affiliateList.map((product) => {
            let filterKey = 'other';
            if (product.categoryZh.includes('Web3') || product.categoryZh.includes('金融')) filterKey = 'Web3';
            else if (product.categoryZh.includes('软件')) filterKey = '软件';
            else if (product.categoryZh.includes('硬件')) filterKey = '数码';
            else if (product.categoryZh.includes('AI') || product.categoryZh.includes('开发')) filterKey = 'AI';
            else if (product.categoryZh.includes('生活')) filterKey = '生活';

            return (
              <div class="product-item" data-category={filterKey}>
                <ProductCard product={product} />
              </div>
            );
          })}
        </div>
      </>
    ) : (
      <!-- Empty State -->
      <div class="my-12 rounded-3xl border border-dashed border-kraft-300 dark:border-stone-800 p-16 text-center bg-[#FAF7F2]/50 dark:bg-[#1E1B18]/50">
        <span class="text-5xl mb-4 block">📦</span>
        <h3 class="text-lg font-bold text-kraft-950 dark:text-stone-100 mb-2">
          <span class="lang-zh">真实好物清单正在陆续录入中</span>
          <span class="lang-en">Curating Verified Items</span>
        </h3>
        <p class="text-xs text-kraft-600 dark:text-stone-400 max-w-md mx-auto leading-relaxed mb-6">
          <span class="lang-zh">为保证每一款推荐的真实性与高转化率，未获深度实测或尚未接入真实官方返佣链接的商品均保持空白。首批真实商品即将上架。</span>
          <span class="lang-en">To ensure genuine authenticity, products without real links or long-term evaluation remain blank. The verified list will be populated soon.</span>
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll('.cat-btn');
  const items = document.querySelectorAll('.product-item');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-filter');

      buttons.forEach((b) => {
        b.className = 'cat-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-[#FAF7F2] text-kraft-700 hover:bg-kraft-150 dark:bg-stone-900 dark:text-stone-300 dark:hover:bg-stone-800 border border-kraft-250 dark:border-stone-800';
      });
      btn.className = 'cat-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-kraft-900 text-kraft-50 dark:bg-stone-100 dark:text-stone-950 shadow-xs';

      items.forEach((item) => {
        const itemCat = item.getAttribute('data-category');
        if (selected === 'all' || itemCat === selected) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
