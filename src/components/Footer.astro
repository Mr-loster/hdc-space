---
import { siteConfig } from '../data/siteConfig';

const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-kraft-200 dark:border-stone-800 bg-[#F5EFE6] dark:bg-[#171513] py-12 transition-colors">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- Brand & Mission -->
      <div class="md:col-span-1 space-y-3">
        <div class="flex items-center gap-2.5">
          <img src={siteConfig.avatar} alt="HDC" class="h-8 w-8 rounded-full object-cover ring-1 ring-kraft-300 dark:ring-stone-700" />
          <span class="font-extrabold text-lg text-kraft-900 dark:text-stone-100">
            <span class="lang-zh">HDC的空间</span>
            <span class="lang-en">HDC's Space</span>
          </span>
        </div>
        <p class="text-xs leading-relaxed text-kraft-600 dark:text-stone-400">
          <span class="lang-zh">
            {siteConfig.descriptionZh} 这里没有商业充值的水文，只有真正经受住高强度检验的数字工具与数码装备。
          </span>
          <span class="lang-en">
            {siteConfig.descriptionEn} Filtering out marketing noise through honest, long-term testing to surface tools truly worth your time.
          </span>
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-kraft-900 dark:text-stone-200 mb-3">
          <span class="lang-zh">快捷导航</span>
          <span class="lang-en">Explore</span>
        </h4>
        <ul class="space-y-2 text-xs text-kraft-700 dark:text-stone-400">
          <li>
            <a href="/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              <span class="lang-zh">首页概览</span>
              <span class="lang-en">Home</span>
            </a>
          </li>
          <li>
            <a href="/gear" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              <span class="lang-zh">精选好物</span>
              <span class="lang-en">Curated Gear</span>
            </a>
          </li>
          <li>
            <a href="/reviews" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              <span class="lang-zh">深度测评</span>
              <span class="lang-en">In-Depth Reviews</span>
            </a>
          </li>
          <li>
            <a href="/about" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              <span class="lang-zh">关于 HDC</span>
              <span class="lang-en">About HDC</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-kraft-900 dark:text-stone-200 mb-3">
          <span class="lang-zh">联系与社交</span>
          <span class="lang-en">Connect</span>
        </h4>
        <ul class="space-y-2.5 text-xs text-kraft-700 dark:text-stone-400">
          <li>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors flex items-center gap-1.5 font-mono">
              <span>✉️</span>
              <span>{siteConfig.email}</span>
            </a>
          </li>
          <li>
            <a href={siteConfig.socialUrl} target="_blank" rel="noopener noreferrer" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors flex items-center gap-1.5 font-mono">
              <span>𝕏</span>
              <span>{siteConfig.socialHandle}</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal & Affiliate Info -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-kraft-900 dark:text-stone-200 mb-3">
          <span class="lang-zh">合规与合作</span>
          <span class="lang-en">Transparency</span>
        </h4>
        <p class="text-[11px] leading-relaxed text-kraft-600 dark:text-stone-400 mb-2">
          <span class="lang-zh">本站遵循搜索引擎合规标准与各大联盟协议，所有外链均采用规范的追踪重定向。</span>
          <span class="lang-en">Compliant with FTC guidelines. Outbound links use standard <code>rel="nofollow sponsored"</code> attributes.</span>
        </p>
        <a href="/about#disclosure" class="text-[11px] font-semibold text-brand-600 dark:text-brand-400 underline hover:no-underline">
          <span class="lang-zh">查看完整返佣合作披露 →</span>
          <span class="lang-en">Read full affiliate disclosure →</span>
        </a>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="border-t border-kraft-200/80 dark:border-stone-800/80 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-kraft-500 dark:text-stone-500 gap-2">
      <p>© {currentYear} HDC的空间 (HDC's Space). All rights reserved.</p>
      <p class="flex items-center gap-1 text-[11px]">
        <span>Astro + Kraft Tone Design</span>
        <span>•</span>
        <span class="lang-zh">静态秒开架构</span>
        <span class="lang-en">Static Edge Performance</span>
      </p>
    </div>
  </div>
</footer>
