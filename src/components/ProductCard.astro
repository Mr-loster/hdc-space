---
import type { AffiliateItem } from '../data/affiliates';

interface Props {
  product: AffiliateItem;
  showCategory?: boolean;
}

const { product, showCategory = true } = Astro.props;
---

<div class="group relative flex flex-col justify-between rounded-2xl border border-kraft-200/90 bg-[#FAF7F2] p-5 shadow-xs transition-all duration-200 hover:-translate-y-1 hover:border-brand-500/50 hover:shadow-md dark:border-stone-800 dark:bg-[#201D1A] dark:hover:border-brand-400/40">
  <div>
    <!-- Top Bar: Icon, Badge, Category -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-2.5">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-kraft-150 text-2xl shadow-inner dark:bg-stone-800 group-hover:scale-105 transition-transform">
          {product.icon}
        </span>
        <div>
          <h3 class="font-bold text-base text-kraft-900 dark:text-stone-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
            {product.name}
          </h3>
          {showCategory && (
            <span class="text-[11px] font-medium text-kraft-600 dark:text-stone-400">
              <span class="lang-zh">{product.categoryZh}</span>
              <span class="lang-en">{product.categoryEn}</span>
            </span>
          )}
        </div>
      </div>

      <!-- Badge if available -->
      {(product.badgeZh || product.badgeEn) && (
        <span class="rounded-full bg-brand-100/80 px-2.5 py-0.5 text-[11px] font-semibold text-brand-800 ring-1 ring-inset ring-brand-600/20 dark:bg-brand-950/70 dark:text-brand-300 dark:ring-brand-500/30">
          <span class="lang-zh">{product.badgeZh}</span>
          <span class="lang-en">{product.badgeEn}</span>
        </span>
      )}
    </div>

    <!-- Tagline & Description -->
    <p class="text-xs font-semibold text-kraft-800 dark:text-stone-200 mb-2">
      <span class="lang-zh">{product.taglineZh}</span>
      <span class="lang-en">{product.taglineEn}</span>
    </p>
    <p class="text-xs text-kraft-600 dark:text-stone-400 leading-relaxed mb-4 line-clamp-3">
      <span class="lang-zh">{product.descriptionZh}</span>
      <span class="lang-en">{product.descriptionEn}</span>
    </p>
  </div>

  <!-- Bottom Part: Price, Coupon, Poster & Action Button -->
  <div class="border-t border-kraft-200/80 dark:border-stone-800/80 pt-3.5 space-y-3">
    <!-- Meta: Rating & Pricing -->
    <div class="flex items-center justify-between text-xs">
      {product.rating && (
        <div class="flex items-center gap-1 text-amber-600 dark:text-amber-400 font-bold">
          <span>★</span>
          <span>{product.rating.toFixed(1)}</span>
        </div>
      )}
      {(product.priceZh || product.priceEn) && (
        <span class="font-medium text-kraft-700 dark:text-stone-400 text-right">
          <span class="lang-zh">{product.priceZh}</span>
          <span class="lang-en">{product.priceEn}</span>
        </span>
      )}
    </div>

    <!-- Coupon Badge if any -->
    {(product.couponZh || product.couponEn) && (
      <div class="rounded-lg bg-amber-500/10 dark:bg-amber-400/10 border border-amber-500/20 p-2 text-[11px] text-amber-900 dark:text-amber-200 flex items-center justify-between">
        <span class="font-semibold truncate">
          <span class="lang-zh">🎁 {product.couponZh}</span>
          <span class="lang-en">🎁 {product.couponEn}</span>
        </span>
      </div>
    )}

    <!-- Action Buttons Row -->
    <div class="flex items-center gap-2">
      <!-- Main Affiliate Redirect Button -->
      <a
        href={`/go/${product.slug}`}
        target="_blank"
        rel="nofollow sponsored"
        class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-xl bg-kraft-900 px-4 py-2.5 text-xs font-bold text-kraft-50 shadow-xs transition-all hover:bg-brand-600 active:scale-[0.98] dark:bg-stone-100 dark:text-stone-950 dark:hover:bg-brand-400 dark:hover:text-stone-950"
      >
        <span class="lang-zh">立即直达注册 / 领福利</span>
        <span class="lang-en">Sign Up with Bonus</span>
        <span class="text-xs">↗</span>
      </a>

      <!-- Optional Poster View Button -->
      {product.posterImage && (
        <button
          type="button"
          data-poster={product.posterImage}
          data-title={product.name}
          class="poster-btn shrink-0 inline-flex items-center justify-center gap-1 rounded-xl border border-kraft-300 dark:border-stone-700 bg-kraft-100 dark:bg-stone-800 px-3 py-2.5 text-xs font-semibold text-kraft-800 dark:text-stone-200 hover:bg-kraft-200 active:scale-95 transition-all"
          title="查看官方海报与二维码"
        >
          <span>🖼️</span>
          <span class="lang-zh">海报</span>
          <span class="lang-en">Poster</span>
        </button>
      )}
    </div>
  </div>
</div>

<!-- Lightbox Modal for Poster -->
<dialog id="poster-modal" class="backdrop:bg-black/70 rounded-3xl p-0 border border-kraft-300 dark:border-stone-700 bg-[#FAF7F2] dark:bg-[#1C1917] shadow-2xl max-w-sm w-full mx-auto my-auto overflow-hidden">
  <div class="p-4 flex items-center justify-between border-b border-kraft-200 dark:border-stone-800">
    <h4 id="poster-modal-title" class="font-bold text-sm text-kraft-900 dark:text-stone-100"></h4>
    <button id="poster-close-btn" class="h-8 w-8 rounded-full bg-kraft-200/60 dark:bg-stone-800 text-kraft-800 dark:text-stone-200 text-xs font-bold flex items-center justify-center hover:bg-kraft-300">
      ✕
    </button>
  </div>
  <div class="p-4 flex justify-center bg-stone-950/5 dark:bg-black/30">
    <img id="poster-modal-img" src="" alt="Poster" class="max-h-[68vh] rounded-xl object-contain shadow-md" />
  </div>
  <div class="p-3.5 text-center border-t border-kraft-200 dark:border-stone-800 text-xs text-kraft-600 dark:text-stone-400">
    <span class="lang-zh">长按保存海报或微信/浏览器扫码直接直达</span>
    <span class="lang-en">Long-press to save or scan the QR code</span>
  </div>
</dialog>

<script>
  // Poster Lightbox
  const modal = document.getElementById('poster-modal') as HTMLDialogElement;
  const modalImg = document.getElementById('poster-modal-img') as HTMLImageElement;
  const modalTitle = document.getElementById('poster-modal-title');
  const closeBtn = document.getElementById('poster-close-btn');

  document.querySelectorAll('.poster-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const img = btn.getAttribute('data-poster') || '';
      const title = btn.getAttribute('data-title') || '';
      if (modal && modalImg) {
        modalImg.src = img;
        if (modalTitle) modalTitle.textContent = `${title} - 专属邀请海报`;
        modal.showModal();
      }
    });
  });

  closeBtn?.addEventListener('click', () => {
    modal?.close();
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.close();
    }
  });
</script>
